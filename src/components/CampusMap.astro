---
/**
 * The PKU campus map.
 *
 * Plain inline SVG, drawn at build time from data/pku-campus.geojson.
 *
 * Why not MapLibre, like the Beijing map:
 * a campus is one screen at one zoom. Panning and tiling buy nothing here, and
 * a second WebGL canvas would cost another basemap fetch, break in every
 * environment where rAF is throttled, and — as AGENTS.md records — fail
 * silently when it does. An SVG renders in a screenshot, in a print, and in a
 * browser pane that has paused animation frames.
 *
 * Why not PKU's own map, which is prettier:
 * it is PKU's artwork, and it is drawn for charm rather than accuracy —
 * buildings sit where they looked good. It was used as the *naming* source (it
 * is the authoritative bilingual list of what everything is called) and for
 * nothing else. Every coordinate below comes from OpenStreetMap.
 *
 * The first version drew only the campus outline, the ponds and the pins, and
 * it was unreadable: ponds floating on a blank field look like specks, not like
 * a place. Buildings and the road network are what make it legible — they are
 * the underlay, and they matter more than the pins do.
 *
 * Coordinates are WGS-84, like everywhere else on this site. Nothing here is
 * eyeballed off an image — see `npm run fetch:campus`.
 */
import { parse } from 'yaml';
// ?raw for the same reason BeijingMap does it: reading with fs and
// import.meta.url resolves against the bundled chunk at build time, not this
// file, and dies with ENOENT during `astro build`.
import campusRaw from '../../data/pku-campus.geojson?raw';
import placesRaw from '../../data/places.yaml?raw';

type Pt = [number, number];
const campus = JSON.parse(campusRaw) as {
	features: { geometry: any; properties: Record<string, any> }[];
};

const layer = (n: string) => campus.features.filter((f) => f.properties.layer === n);
const boundary = layer('boundary')[0];
const buildings = layer('building');
const roads = layer('road');
const placePts = layer('place');

const ringOf = (f: any) => f.geometry.coordinates[0] as Pt[];
const pointInRing = ([x, y]: Pt, r: Pt[]) => {
	let inside = false;
	for (let i = 0, j = r.length - 1; i < r.length; j = i++) {
		const [xi, yi] = r[i];
		const [xj, yj] = r[j];
		if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
	}
	return inside;
};
const centroid = (r: Pt[]): Pt => [
	r.reduce((s, c) => s + c[0], 0) / r.length,
	r.reduce((s, c) => s + c[1], 0) / r.length,
];

const campusRing = boundary ? ringOf(boundary) : [];
// Ponds whose centroid is on campus. The fetch keeps anything within 350 m of
// the wall, which is right for the data and wrong for the drawing — it pulls in
// Yuanmingyuan's lakes, and those read as a bug rather than as a neighbour.
const water = campus.features.filter(
	(f) => f.properties.layer === 'water' && pointInRing(centroid(ringOf(f)), campusRing),
);

/**
 * What a new arrival needs to find. `zh` matches the OSM name exactly, so a pin
 * can never drift onto the wrong building — if OSM renames something the pin
 * disappears rather than lying. `dy` nudges label text only, never the dot.
 */
const WANTED: { zh: string; label: string; kind: string; dy?: number; side?: 'l' | 'r' }[] = [
	{ zh: '北京大学中关新园', label: 'Global Village — home', kind: 'home' },
	// Guanghua: the two nodes up here — the school itself and 2号楼, 72 m apart —
	// are both parts of Building 2, so they get one pin between them. Building 1,
	// the one with the classrooms in it, is 550 m south among the teaching
	// buildings, and was missing from this map entirely.
	{ zh: '光华管理学院2号楼', label: 'Guanghua 2', kind: 'study', dy: -6 },
	{ zh: '光华管理学院1号楼', label: 'Guanghua 1 — classes', kind: 'study', dy: -8 },
	{ zh: '新太阳学生中心（16楼-18楼）', label: 'New Sun — ISD, visas, card', kind: 'admin', side: 'l' },
	{ zh: '北京大学图书馆', label: 'Library', kind: 'study', side: 'l' },
	{ zh: '第二教学楼（李兆基楼）', label: 'Teaching Building 2', kind: 'study', dy: 11, side: 'l' },
	{ zh: '北京大学校医院', label: 'Campus hospital', kind: 'health', side: 'l' },
	{ zh: '燕园派出所', label: 'Yanyuan police station', kind: 'admin' },
	{ zh: '邱德拔体育馆', label: 'Gym & 50 m pool', kind: 'sport' },
	// Every canteen inside the wall, plus 畅春园, which faces the west gate from
	// just outside it and is on the canteens page. 北大青鸟总部食堂 is a company
	// canteen east of campus, not a student one, so it stays off.
	{ zh: '农园餐厅', label: 'Nong Yuan', kind: 'food', dy: -11 },
	{ zh: '佟园餐厅（清真）', label: 'Tong Yuan — halal', kind: 'food' },
	{ zh: '学五食堂', label: 'Xue Wu', kind: 'food' },
	{ zh: '学一食堂', label: 'Xue Yi', kind: 'food' },
	{ zh: '餐饮综合楼（家园食堂）', label: 'Jia Yuan', kind: 'food' },
	{ zh: '艺园餐厅', label: 'Yi Yuan', kind: 'food' },
	{ zh: '燕南食堂', label: 'Yan Nan', kind: 'food' },
	{ zh: '勺园食堂', label: 'Shao Yuan', kind: 'food' },
	{ zh: '松林餐厅', label: 'Song Lin', kind: 'food' },
	{ zh: '畅春园食堂', label: 'Chang Chun Yuan', kind: 'food' },
	{ zh: '成府园食堂', label: 'Chengfu Yuan', kind: 'food' },
	{ zh: '博雅塔', label: 'Boya Tower', kind: 'landmark' },
	{ zh: '中国农业银行', label: 'ABC bank', kind: 'admin', side: 'l' },
	{ zh: '北京大学东门', label: 'East Gate — Line 4', kind: 'metro' },
];

const byName = new Map<string, Pt>();
for (const f of placePts) {
	const n = f.properties.name_zh;
	if (n && !byName.has(n)) byName.set(n, f.geometry.coordinates as Pt);
}

// West Gate comes from places.yaml, where it was looked up and verified for the
// Beijing map. OSM's gate nodes here are a mess — three separate nodes called
// 西门, one of which belongs to Yuanmingyuan. Only the west gate: places.yaml's
// east gate sits on top of the Line 4 pin to within a few metres.
const gates = (parse(placesRaw)?.places ?? []).filter(
	(p: any) => typeof p?.lat === 'number' && /West Gate$/.test(p.name_en ?? ''),
);

// OSM's named nodes are label anchors, not guaranteed to sit inside the thing
// they name. Three of ours don't: 第二教学楼 lands 13 m out in the courtyard
// between blocks, the campus hospital 24 m out and the ABC bank 39 m out — so
// those pins pointed at bare ground next to the building you were looking for.
// Where a node falls outside every footprint, snap it to the nearest building's
// centroid. Anything already inside a footprint is left exactly where it is.
const ringsOf = (f: any): Pt[][] => {
	const g = f.geometry;
	if (g.type === 'Polygon') return [g.coordinates[0]];
	if (g.type === 'MultiPolygon') return g.coordinates.map((poly: Pt[][]) => poly[0]);
	return [];
};

// A representative point that is guaranteed to be *inside* the ring, which the
// centroid is not: 第二教学楼 is an L, and the centroid of an L sits in the
// notch. Take the centroid's latitude, find where that line crosses the ring,
// and use the middle of the widest span it cuts through the building.
const interiorPoint = (ring: Pt[]): Pt => {
	const cy = ring.reduce((a, c) => a + c[1], 0) / ring.length;
	const xs: number[] = [];
	for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
		const [xi, yi] = ring[i];
		const [xj, yj] = ring[j];
		if (yi > cy !== yj > cy) xs.push(xi + ((cy - yi) / (yj - yi)) * (xj - xi));
	}
	xs.sort((a, b) => a - b);
	let best = 0;
	let bestX = ring.reduce((a, c) => a + c[0], 0) / ring.length;
	for (let i = 0; i + 1 < xs.length; i += 2) {
		const span = xs[i + 1] - xs[i];
		if (span > best) {
			best = span;
			bestX = (xs[i] + xs[i + 1]) / 2;
		}
	}
	return [bestX, cy];
};

const footprints: { ring: Pt[]; at: Pt }[] = buildings.flatMap((f: any) =>
	ringsOf(f)
		.filter((r) => r.length > 3)
		.map((ring) => ({ ring, at: interiorPoint(ring) })),
);

const inRing = ([x, y]: Pt, ring: Pt[]) => {
	let inside = false;
	for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
		const [xi, yi] = ring[i];
		const [xj, yj] = ring[j];
		if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
	}
	return inside;
};

const snapToBuilding = (c: Pt): Pt => {
	if (footprints.some((f) => inRing(c, f.ring))) return c;
	// Longitude degrees are shorter than latitude ones; take the factor from the
	// point itself rather than the map-wide `kx`, which is initialised further
	// down the file and would be a use-before-init here.
	const k = Math.cos((c[1] * Math.PI) / 180);
	let best: { d: number; c: Pt } | null = null;
	for (const f of footprints) {
		const d = Math.hypot((f.at[0] - c[0]) * k, f.at[1] - c[1]);
		if (!best || d < best.d) best = { d, c: f.at };
	}
	return best ? best.c : c;
};

const pins = [
	...WANTED.flatMap((w) => {
		const raw = byName.get(w.zh);
		if (!raw) return [];
		const c = snapToBuilding(raw);
		return [{ ...w, lng: c[0], lat: c[1], zhLabel: w.zh }];
	}),
	...gates.map((g: any) => ({
		zh: g.name_zh,
		zhLabel: g.name_zh,
		label: 'West Gate',
		kind: 'gate',
		side: 'r' as const,
		dy: 0,
		lng: g.lng,
		lat: g.lat,
	})),
];

// ── Projection ──────────────────────────────────────────────────────────────
// Equirectangular, scaled by cos(latitude). Over 1.5 km the difference from a
// proper Mercator is far under a pixel, and it keeps this file free of a
// projection dependency.
const all: Pt[] = [
	...(boundary ? (boundary.geometry.coordinates[0] as Pt[]) : []),
	...pins.map((p) => [p.lng, p.lat] as Pt),
];
const lons = all.map((c) => c[0]);
const lats = all.map((c) => c[1]);
const PAD = 0.0011;
const minLon = Math.min(...lons) - PAD;
const maxLon = Math.max(...lons) + PAD;
const minLat = Math.min(...lats) - PAD;
const maxLat = Math.max(...lats) + PAD;

const midLat = (minLat + maxLat) / 2;
const kx = Math.cos((midLat * Math.PI) / 180);

// The map now fills the frame rather than sitting in a box with empty gutters —
// the underlay reaches every edge, so there is nothing to gain from margins.
// Labels are kept inside by flipping their side near the edges instead.
const W = 900;
const H = Math.round((W * (maxLat - minLat)) / ((maxLon - minLon) * kx));

const px = (lon: number) => ((lon - minLon) / (maxLon - minLon)) * W;
const py = (lat: number) => H - ((lat - minLat) / (maxLat - minLat)) * H;

// One decimal is ~0.15 m on this frame; more just inflates the page.
const d1 = (n: number) => Math.round(n * 10) / 10;

/**
 * Ramer–Douglas–Peucker, run in *projected* units rather than degrees.
 *
 * That's the point: a tolerance in metres has to be converted in your head to
 * know whether it's visible, whereas 0.5 viewBox units is 0.35 of a CSS pixel at
 * the size this renders — provably below what a screen can show. OSM traces
 * kerb lines and building corners at a fidelity meant for zooming in; at one
 * fixed zoom most of those vertices land on the same pixel as their neighbour
 * and cost bytes to say so.
 */
const EPS = 0.5;
function simplify(pts: Pt[]): Pt[] {
	if (pts.length < 3) return pts;
	const [ax, ay] = pts[0];
	const [bx, by] = pts[pts.length - 1];
	const dx = bx - ax;
	const dy = by - ay;
	const len2 = dx * dx + dy * dy;
	let far = 0;
	let idx = 0;
	for (let i = 1; i < pts.length - 1; i++) {
		const [x, y] = pts[i];
		const t = len2 ? Math.max(0, Math.min(1, ((x - ax) * dx + (y - ay) * dy) / len2)) : 0;
		const d = Math.hypot(x - (ax + t * dx), y - (ay + t * dy));
		if (d > far) {
			far = d;
			idx = i;
		}
	}
	if (far <= EPS) return [pts[0], pts[pts.length - 1]];
	return [...simplify(pts.slice(0, idx + 1)).slice(0, -1), ...simplify(pts.slice(idx))];
}

const project = (r: Pt[]): Pt[] => r.map(([lo, la]) => [px(lo), py(la)] as Pt);
const draw = (p: Pt[], close: boolean) =>
	p.map(([x, y], i) => `${i ? 'L' : 'M'}${d1(x)} ${d1(y)}`).join('') + (close ? 'Z' : '');

const poly = (r: Pt[]) => draw(simplify(project(r)), true);
const line = (r: Pt[]) => draw(simplify(project(r)), false);

// Drop buildings too small to read — at this scale they are visual noise and
// several hundred of them are just page weight.
const MIN_BUILDING_PX = 12;
const bigEnough = (r: Pt[]) => {
	const xs = r.map((c) => px(c[0]));
	const ys = r.map((c) => py(c[1]));
	return (Math.max(...xs) - Math.min(...xs)) * (Math.max(...ys) - Math.min(...ys)) > MIN_BUILDING_PX;
};

const buildingPaths = buildings.map(ringOf).filter(bigEnough).map(poly);
const roadMajor = roads.filter((f) => f.properties.major).map((f) => line(f.geometry.coordinates));
const roadMinor = roads.filter((f) => !f.properties.major).map((f) => line(f.geometry.coordinates));

// Label placement, with collision avoidance.
//
// This map carried 13 pins and hand-tuned `dy` nudges was enough. Adding every
// canteen took it to 24, and the canteens are the worst possible case: 学一,
// 松林, 家园 and 艺园 sit inside one block in the south-west. Placing them by
// hand printed "Xue Wu" straight through "New Sun — ISD, visas, card".
//
// So: greedy placement in reading order, north to south. Each label tries its
// preferred side first, then the other side, then the same pair nudged
// progressively further vertically, and takes the first position that clears
// every label and every dot already placed. Flipping sides is tried before
// nudging because a label that has moved 40 units from its own dot is worse
// than one that sits on the other side of it.
//
// Metrics are measured from the rendered SVG rather than guessed: 16px in
// viewBox units, averaging 8.12 units per character.
const CHAR_W = 8.2;
const LABEL_ASC = 13;
const LABEL_DESC = 5;
const GAP = 9;

type Box = { x0: number; x1: number; y0: number; y1: number };
const hits = (a: Box, b: Box) => a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 && b.y0 < a.y1;

const base = pins.map((p) => ({
	...p,
	x: px(p.lng),
	y: py(p.lat),
	r: p.kind === 'home' ? 9 : 6.5,
}));

// Seed with the dots, so no label is allowed to print over another pin's mark.
const taken: Box[] = base.map((p) => ({
	x0: p.x - p.r,
	x1: p.x + p.r,
	y0: p.y - p.r,
	y1: p.y + p.r,
}));

const boxOf = (p: (typeof base)[number], side: 'l' | 'r', baseline: number): Box => {
	const w = p.label.length * CHAR_W;
	const edge = side === 'l' ? p.x - p.r - GAP : p.x + p.r + GAP;
	return {
		x0: side === 'l' ? edge - w : edge,
		x1: side === 'l' ? edge : edge + w,
		y0: baseline - LABEL_ASC,
		y1: baseline + LABEL_DESC,
	};
};

const placement = new Map<number, { side: 'l' | 'r'; dy: number }>();
base
	.map((p, i) => ({ p, i }))
	.sort((a, b) => a.p.y - b.p.y)
	.forEach(({ p, i }) => {
		const prefer = p.side ?? (p.x + p.label.length * CHAR_W + 26 > W ? 'l' : 'r');
		const other: 'l' | 'r' = prefer === 'l' ? 'r' : 'l';
		const start = p.y + 5.5 + (p.dy ?? 0);

		for (const nudge of [0, -20, 20, -40, 40, -60, 60]) {
			for (const side of [prefer, other] as const) {
				const box = boxOf(p, side, start + nudge);
				if (box.x0 < 4 || box.x1 > W - 4) continue;
				if (taken.some((q) => hits(box, q))) continue;
				taken.push(box);
				placement.set(i, { side, dy: (p.dy ?? 0) + nudge });
				return;
			}
		}
		// Nothing clear anywhere: keep the preferred spot rather than dropping the
		// label, so a crowded corner degrades to overlap instead of to silence.
		taken.push(boxOf(p, prefer, start));
		placement.set(i, { side: prefer, dy: p.dy ?? 0 });
	});

// Rebuilt in the original order, so the text key below the map still reads in
// the order the pins were declared rather than north-to-south.
const laid = base.map((p, i) => ({ ...p, ...(placement.get(i) as { side: 'l' | 'r'; dy: number }) }));

const mPerDegLon = 111_320 * kx;
const barM = 300;
const barPx = ((barM / mPerDegLon) / (maxLon - minLon)) * W;
---

<figure class="fl-campus">
	<svg
		viewBox={`0 0 ${W} ${H}`}
		role="img"
		aria-labelledby="campus-title campus-desc"
		class="fl-campus-svg"
	>
		<title id="campus-title">Map of the Peking University campus</title>
		<desc id="campus-desc">
			The walled campus with Weiming Lake at its centre, its buildings and paths, Zhongguanyuan
			Global Village just outside the east side, and the places a new Future Leaders student
			needs: both Guanghua buildings, the New Sun Student Center, the library, the campus
			hospital, the Line 4 station, and every canteen on campus. Every place shown is also
			listed in text below this map.
		</desc>

		<defs>
			{/* Shading, all of it declarative — no filters on 540 buildings, which
			    would cost far more than it looks. The campus gets a soft radial
			    lift so the middle reads as raised; water gets depth from a
			    gradient rather than a flat fill; the wall casts a real shadow so
			    the campus sits above the city instead of beside it. */}
			<radialGradient id="fl-ground-lift" cx="46%" cy="42%" r="72%">
				<stop offset="0%" stop-color="var(--campus-ground-hi)" />
				<stop offset="100%" stop-color="var(--campus-ground)" />
			</radialGradient>
			<linearGradient id="fl-water-depth" x1="0" y1="0" x2="0.25" y2="1">
				<stop offset="0%" stop-color="var(--campus-water-hi)" />
				<stop offset="100%" stop-color="var(--campus-water)" />
			</linearGradient>
			<filter id="fl-campus-shadow" x="-6%" y="-6%" width="112%" height="112%">
				<feDropShadow dx="0" dy="4" stdDeviation="7" flood-color="var(--campus-shadow)" />
			</filter>
		</defs>

		<rect x="0" y="0" width={W} height={H} class="fl-campus-city" />

		{
			boundary && (
				<path
					d={poly(boundary.geometry.coordinates[0])}
					class="fl-campus-ground"
					filter="url(#fl-campus-shadow)"
				/>
			)
		}

		{buildingPaths.map((d) => <path d={d} class="fl-campus-building" />)}

		{water.map((w) => <path d={poly(w.geometry.coordinates[0])} class="fl-campus-water" />)}

		<g class="fl-campus-roads" fill="none">
			{roadMinor.map((d) => <path d={d} class="fl-campus-path" />)}
			{roadMajor.map((d) => <path d={d} class="fl-campus-road" />)}
		</g>

		{boundary && <path d={poly(boundary.geometry.coordinates[0])} class="fl-campus-wall" />}

		{
			laid.map((p) => (
				<g class="fl-campus-pin" data-kind={p.kind}>
					<circle cx={d1(p.x)} cy={d1(p.y)} r={p.r} class="fl-campus-dot" />
					<text
						x={d1(p.side === 'l' ? p.x - p.r - 9 : p.x + p.r + 9)}
						y={d1(p.y + 5.5 + (p.dy ?? 0))}
						text-anchor={p.side === 'l' ? 'end' : 'start'}
						class="fl-campus-label"
					>
						{p.label}
					</text>
				</g>
			))
		}

		<g class="fl-campus-scale" aria-hidden="true">
			<line x1="16" y1={H - 20} x2={16 + barPx} y2={H - 20} />
			<line x1="16" y1={H - 25} x2="16" y2={H - 15} />
			<line x1={16 + barPx} y1={H - 25} x2={16 + barPx} y2={H - 15} />
			<text x={16 + barPx / 2} y={H - 28} text-anchor="middle">{barM} m</text>
		</g>
	</svg>

	<figcaption>
		Every building, path and pond here is drawn from OpenStreetMap, so the distances are real —
		unlike PKU's own map, which is lovely and is drawn for charm. Names are the ones on the
		official map, in both languages, because the Chinese one is what you show somebody when
		you're lost.
	</figcaption>

	<ul class="fl-campus-key">
		{
			laid.map((p) => (
				<li data-kind={p.kind}>
					<strong>{p.label}</strong>
					<span lang="zh-CN">{p.zhLabel}</span>
				</li>
			))
		}
	</ul>
</figure>
