---
/**
 * Our own icon set.
 *
 * Starlight ships 125 icons but none of them mean "map pin", "subway" or
 * "passport" — the three things this guide talks about most. (Using a name it
 * doesn't have fails silently and renders nothing, which is how `map-pin` sat
 * broken on the landing page.)
 *
 * These are drawn on a 24×24 grid with a 1.7 stroke to sit comfortably next to
 * DM Sans, and inherit currentColor so they work on crimson and on parchment.
 */
export type IcoName =
	| 'pin'
	| 'subway'
	| 'passport'
	| 'bowl'
	| 'glass'
	| 'stethoscope'
	| 'cap'
	| 'compass'
	| 'siren'
	| 'search'
	| 'chat'
	| 'pencil'
	| 'plane'
	| 'copy';

interface Props {
	name: IcoName;
	size?: number;
	class?: string;
}
const { name, size = 20, class: className = '' } = Astro.props;

const PATHS: Record<IcoName, string> = {
	// Map pin — the one Starlight is missing and we needed most
	pin: '<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>',
	// Subway car on a rail
	subway:
		'<rect x="6" y="3" width="12" height="13" rx="3"/><path d="M6 10h12M9.5 19.5 7 22M14.5 19.5 17 22M4 22h16"/><circle cx="9" cy="13.2" r=".9" fill="currentColor" stroke="none"/><circle cx="15" cy="13.2" r=".9" fill="currentColor" stroke="none"/>',
	// Passport / travel document
	passport:
		'<rect x="5" y="2.5" width="14" height="19" rx="2.2"/><circle cx="12" cy="10" r="3.2"/><path d="M9.4 16.5h5.2"/>',
	// Rice bowl with chopsticks
	bowl: '<path d="M3.5 11h17a8.5 8.5 0 0 1-17 0Z"/><path d="M6 21h12"/><path d="M14.5 8.2 19 3.2M17 8.6l3.6-4"/>',
	// Drink
	glass: '<path d="M4 4h16l-8 8.5Z"/><path d="M12 12.5V20M8 20h8"/>',
	// Health
	stethoscope:
		'<path d="M6 3v5a4.5 4.5 0 0 0 9 0V3"/><path d="M4.5 3h3M13.5 3h3"/><path d="M10.5 12.5v2.2a4.8 4.8 0 0 0 9.5 0"/><circle cx="20" cy="16" r="2"/>',
	// Academics
	cap: '<path d="M12 4 2.5 8.8 12 13.6l9.5-4.8Z"/><path d="M6.5 11.2v4.6c0 1.7 2.5 3 5.5 3s5.5-1.3 5.5-3v-4.6"/><path d="M21.5 8.8v5.4"/>',
	// Exploring
	compass: '<circle cx="12" cy="12" r="9"/><path d="m15.4 8.6-2 4.8-4.8 2 2-4.8Z"/>',
	// Emergency
	siren:
		'<path d="M6 18v-5a6 6 0 0 1 12 0v5"/><path d="M4 18h16a1.5 1.5 0 0 1 0 3H4a1.5 1.5 0 0 1 0-3Z"/><path d="M12 3.5V2M4.6 6.2 3.5 5.1M19.4 6.2l1.1-1.1"/>',
	search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.8-4.8"/>',
	chat: '<path d="M20.5 12.2c0 4-3.8 7.2-8.5 7.2a10 10 0 0 1-2.7-.36L4 21l1.4-3.5A6.9 6.9 0 0 1 3.5 12.2C3.5 8.2 7.3 5 12 5s8.5 3.2 8.5 7.2Z"/>',
	pencil:
		'<path d="M4 20.5h4L20 8.5a2.6 2.6 0 0 0-3.7-3.7L4 16.8Z"/><path d="m15.2 6 3.7 3.7"/>',
	plane: '<path d="M2.5 13.4 21 5l-3.4 8.6L21 22l-5.9-5-4.1 2.8-.6-4.2Z"/>',
	copy: '<rect x="8.5" y="8.5" width="12" height="12" rx="2.2"/><path d="M15.5 5.2A2.2 2.2 0 0 0 13.3 3H5.7A2.7 2.7 0 0 0 3 5.7v7.6a2.2 2.2 0 0 0 2.2 2.2"/>',
};
---

<svg
	class={`fl-ico ${className}`}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.7"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={PATHS[name]}
/>

<style>
	.fl-ico {
		flex: none;
		vertical-align: -0.18em;
	}
</style>
