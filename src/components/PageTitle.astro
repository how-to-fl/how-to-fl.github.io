---
/**
 * Overrides Starlight's default page title to append a freshness line.
 *
 * This is the highest-leverage twenty lines in the project: a guide people
 * trust is worth more than a guide that is merely comprehensive. Every page
 * says out loud when it was last checked, and shouts when that was too long
 * ago — so a reader in 2029 knows what they are looking at.
 */
const { entry } = Astro.locals.starlightRoute;
const { title, last_verified, status, owner, template } = entry.data as {
	title: string;
	last_verified?: string;
	status?: 'stub' | 'draft' | 'live';
	owner?: string;
	template?: string;
};

// Splash pages carry their own hero, which already contains the h1 and needs no
// freshness furniture — rendering this as well gives you the title twice.
const isSplash = template === 'splash';

const STALE_AFTER_MONTHS = 12;

/** Months between a YYYY-MM string and today. */
function monthsSince(stamp: string): number {
	const [y, m] = stamp.split('-').map(Number);
	const now = new Date();
	return (now.getFullYear() - y) * 12 + (now.getMonth() + 1 - m);
}

const age = last_verified ? monthsSince(last_verified) : null;
const isStale = age !== null && age > STALE_AFTER_MONTHS;

/** "2026-08" -> "August 2026" */
const verifiedLabel = last_verified
	? new Date(`${last_verified}-01T00:00:00Z`).toLocaleDateString('en-GB', {
			month: 'long',
			year: 'numeric',
			timeZone: 'UTC',
		})
	: null;
---

{!isSplash && <h1 id="_top">{title}</h1>}

{
	!isSplash && status === 'stub' && (
		<p class="fl-note fl-note--stub">
			<strong>Nobody's written this one yet.</strong> We've laid out the headings; the words are
			missing.
			{owner ? ` ${owner} looks after it.` : " It's nobody's yet — take it?"} Filling in a single
			heading counts, and{' '}
			<a href="https://github.com/how-to-fl/how-to-fl.github.io/blob/main/CONTRIBUTING.md">
				here's how
			</a>
			.
		</p>
	)
}

{
	!isSplash && isStale && (
		<p class="fl-verified fl-verified--stale">
			Last checked {verifiedLabel} — worth confirming anything that matters to you
		</p>
	)
}

{
	!isSplash && !isStale && verifiedLabel && status !== 'stub' && (
		<p class="fl-verified">One of us checked this in {verifiedLabel}{owner ? ` · ${owner}` : ''}</p>
	)
}
